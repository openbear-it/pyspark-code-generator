# URL base OpenAI-compatible. Include /v1 when required by the provider.
LLM_BASE_URL=https://api.openai.com/v1

# Add your provider key in .env. Never commit the .env file.
LLM_API_KEY=replace-with-your-api-key

# Example: gpt-4o-mini. Use a model available from your provider.
LLM_MODEL=gpt-4o-mini

# Maximum tokens requested for generated responses. Keep within the model limit.
LLM_MAX_OUTPUT_TOKENS=4096

# Maximum continuation requests after a response reaches its output limit.
LLM_MAX_CONTINUATIONS=2

# Set to false to accept a self-signed certificate from the LLM endpoint.
LLM_VERIFY_SSL=false

# Optional: local SQLite persistence location.
DATABASE_PATH=./data/chats.db